{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node", "vitest/globals"],
		"strict": true,
		"experimentalDecorators": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true
	},
	"exclude": ["content/**"]
}
