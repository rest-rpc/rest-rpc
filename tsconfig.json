{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"declaration": true,
		"rewriteRelativeImportExtensions": true
	},
	"exclude": ["**/*.test.ts", "**/*.type-test.ts"]
}
