{
	"name": "contract-first-api",
	"private": true,
	"type": "module",
	"description": "Contract-first TypeScript tools for shared API schemas, typed clients, Express servers, and React Query integration.",
	"keywords": [
		"contract-first",
		"api",
		"typescript",
		"zod",
		"express",
		"react-query"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/contract-first-api.git"
	},
	"homepage": "https://github.com/simoalanne/contract-first-api#readme",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"build:packages": "pnpm -r --filter './packages/**' build",
		"typecheck": "pnpm run build:packages && pnpm run typecheck:workspace",
		"typecheck:workspace": "pnpm -r --parallel --no-bail typecheck",
		"test": "pnpm -r --parallel --no-bail --if-present test",
		"lint": "biome check --write .",
		"lint:verify": "biome check .",
		"lint:staged": "biome check --write --staged --no-errors-on-unmatched",
		"lint:write": "pnpm run lint:staged",
		"lint:unsafe": "biome check --write --unsafe --staged --no-errors-on-unmatched",
		"check": "pnpm run lint && pnpm run typecheck && pnpm run test",
		"check:verify": "pnpm run lint:verify && pnpm run typecheck && pnpm run test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"lefthook": "2.1.5",
		"typescript": "^5.9.3"
	}
}
