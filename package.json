{
	"name": "my-own-contract-first",
	"private": true,
	"type": "module",
	"description": "Contract-first TypeScript tools for shared API schemas, typed clients, Express servers, and React Query integration.",
	"keywords": [
		"contract-first",
		"api",
		"typescript",
		"zod",
		"express",
		"react-query"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/contract-first-api.git"
	},
	"homepage": "https://github.com/simoalanne/contract-first-api#readme",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"build:packages": "pnpm -r --parallel --no-bail --filter @contract-first-api/core --filter @contract-first-api/api-client --filter @contract-first-api/express --filter @contract-first-api/react-query build",
		"typecheck": "pnpm -r --parallel --no-bail typecheck",
		"test": "pnpm -r --parallel --no-bail --if-present test",
		"lint": "biome check --write",
		"lint:unsafe": "biome check --write --unsafe ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"lefthook": "2.1.5",
		"typescript": "^5.9.3"
	}
}
