{
	"name": "@contract-first-api/express",
	"version": "4.4.0",
	"type": "module",
	"description": "Mount shared API contract on an Express app with typed handlers and request validation.",
	"keywords": [
		"contract-first",
		"express",
		"api",
		"typescript",
		"zod",
		"backend"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/contract-first-api.git"
	},
	"homepage": "https://github.com/simoalanne/contract-first-api#readme",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"prepublishOnly": "node ../../scripts/ensure-pnpm-publish.cjs",
		"typecheck": "tsc -p tsconfig.json",
		"test": "pnpm --filter @contract-first-api/server build && node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@contract-first-api/core": "workspace:^",
		"@contract-first-api/server": "workspace:^"
	},
	"devDependencies": {
		"@types/express": "^5.0.1",
		"@types/ws": "^8.18.1"
	},
	"peerDependencies": {
		"express": "^5.0.0",
		"ws": "^8.21.0"
	}
}
