{
	"name": "@rest-rpc/express",
	"version": "0.1.0-beta.17",
	"description": "Express adapter for serving rest-rpc contracts with typed HTTP and WebSocket routes.",
	"keywords": [
		"api-contract",
		"contract-first",
		"express",
		"expressjs",
		"http",
		"middleware",
		"rest",
		"rest-rpc",
		"rpc",
		"server",
		"type-safe-api",
		"typescript",
		"websocket",
		"ws"
	],
	"homepage": "https://github.com/rest-rpc/rest-rpc#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git",
		"directory": "packages/express"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "pnpm --filter @rest-rpc/server build && node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*",
		"@rest-rpc/server": "workspace:*"
	},
	"devDependencies": {
		"@types/express": "^5.0.1",
		"@types/ws": "^8.18.1"
	},
	"peerDependencies": {
		"express": "^5.0.0",
		"ws": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"ws": {
			"optional": true
		}
	}
}
