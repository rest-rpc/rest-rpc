{
	"name": "@rest-rpc/express",
	"version": "0.1.0-beta.1",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git"
	},
	"homepage": "https://github.com/rest-rpc/rest-rpc#readme",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"prepublishOnly": "node ../../scripts/ensure-pnpm-publish.cjs",
		"typecheck": "tsc -p tsconfig.json",
		"test": "pnpm --filter @rest-rpc/server build && node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:^",
		"@rest-rpc/server": "workspace:^"
	},
	"devDependencies": {
		"@types/express": "^5.0.1",
		"@types/ws": "^8.18.1"
	},
	"peerDependencies": {
		"express": "^5.0.0",
		"ws": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"ws": {
			"optional": true
		}
	}
}
