{
	"name": "@contract-first-api/core",
	"version": "4.4.0",
	"type": "module",
	"description": "Define shared API contract and derive typed request and response helpers from Zod schemas.",
	"keywords": [
		"contract-first",
		"api",
		"typescript",
		"zod",
		"schema"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/contract-first-api.git"
	},
	"homepage": "https://github.com/simoalanne/contract-first-api#readme",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./contract": {
			"types": "./dist/contract.d.ts",
			"import": "./dist/contract.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		},
		"./openapi": {
			"types": "./dist/openapi.d.ts",
			"import": "./dist/openapi.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"prepublishOnly": "node ../../scripts/ensure-pnpm-publish.cjs",
		"typecheck": "tsc -p tsconfig.json",
		"test": "node --test src/*.test.ts src/**/*.test.ts"
	},
	"dependencies": {
		"zod": "^4.3.6"
	}
}
