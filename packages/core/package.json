{
	"name": "@contract-first-api/core",
	"version": "4.2.1",
	"type": "module",
	"description": "Define shared API contracts and derive typed request and response helpers from Zod schemas.",
	"keywords": [
		"contract-first",
		"api",
		"typescript",
		"zod",
		"schema",
		"contracts"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/contract-first-api.git"
	},
	"homepage": "https://github.com/simoalanne/contract-first-api#readme",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./contracts": {
			"types": "./dist/contracts.d.ts",
			"import": "./dist/contracts.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "node --test src/*.test.ts src/**/*.test.ts"
	},
	"dependencies": {
		"zod": "^4.3.6"
	}
}
