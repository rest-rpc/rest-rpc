{
	"name": "@rest-rpc/tanstack-query",
	"version": "0.1.0-beta.8",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git"
	},
	"homepage": "https://github.com/rest-rpc/rest-rpc#readme",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"prepublishOnly": "node ../../scripts/ensure-pnpm-publish.cjs",
		"typecheck": "tsc -p tsconfig.json && tsd",
		"test": "node --test src/**/*.test.ts"
	},
	"tsd": {
		"directory": "test-d"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:^"
	},
	"peerDependencies": {
		"@tanstack/query-core": "^5.0.0"
	},
	"devDependencies": {
		"esmock": "^2.7.3"
	}
}
