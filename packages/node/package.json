{
	"name": "@rest-rpc/node",
	"version": "0.1.0-beta.25",
	"description": "Node HTTP adapter for serving rest-rpc contracts with IncomingMessage and ServerResponse handlers.",
	"keywords": [
		"api-contract",
		"contract-first",
		"http",
		"node",
		"nodejs",
		"request",
		"response",
		"rest",
		"rest-rpc",
		"rpc",
		"server",
		"type-safe-api",
		"typescript"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git",
		"directory": "packages/node"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./adapter": "./src/adapter.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./adapter": {
				"types": "./dist/adapter.d.ts",
				"import": "./dist/adapter.js"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit --declaration false"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*",
		"@rest-rpc/fetch": "workspace:*",
		"@rest-rpc/server": "workspace:*"
	}
}
