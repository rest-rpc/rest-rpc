{
	"name": "@contract-first-api/openapi",
	"version": "1.0.1",
	"type": "module",
	"description": "Generate OpenAPI documents from contract-first API contract trees.",
	"keywords": [
		"contract-first",
		"openapi",
		"zod",
		"schema",
		"contracts"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/contract-first-api.git"
	},
	"homepage": "https://github.com/simoalanne/contract-first-api#readme",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@contract-first-api/core": "workspace:^",
		"zod": "^4.3.6"
	}
}
