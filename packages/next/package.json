{
	"name": "@rest-rpc/next",
	"version": "0.1.0-beta.7",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"prepublishOnly": "node ../../scripts/ensure-pnpm-publish.cjs",
		"test": "node --test src/*.test.ts src/**/*.test.ts",
		"typecheck": "pnpm run build && tsc -p tsconfig.json"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:^",
		"@rest-rpc/web": "workspace:^"
	}
}
