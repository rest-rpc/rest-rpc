{
	"name": "@rest-rpc/next",
	"version": "0.1.0-beta.12",
	"type": "module",
	"license": "MIT",
	"description": "Next.js adapter for serving and consuming rest-rpc contracts in App Router projects.",
	"keywords": [
		"rest-rpc",
		"typescript",
		"rpc",
		"rest",
		"api-contract",
		"contract-first",
		"type-safe-api",
		"next",
		"nextjs",
		"app-router",
		"route-handler",
		"fetch",
		"react",
		"server-components"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git",
		"directory": "packages/next"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"prepublishOnly": "node ../../scripts/ensure-pnpm-publish.cjs",
		"test": "node --test src/*.test.ts src/**/*.test.ts",
		"typecheck": "pnpm run build && tsc -p tsconfig.json && tsd"
	},
	"tsd": {
		"directory": "test-d"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*",
		"@rest-rpc/web": "workspace:*"
	},
	"peerDependencies": {
		"next": ">=15"
	},
	"devDependencies": {
		"next": "16.3.1"
	}
}
