{
	"name": "@contract-first-api/react-query",
	"version": "3.0.0",
	"type": "module",
	"description": "Wrap a contract-first API client with React Query hooks and cache helpers.",
	"keywords": [
		"contract-first",
		"react-query",
		"tanstack-query",
		"react",
		"typescript",
		"api-client"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/contract-first-api.git"
	},
	"homepage": "https://github.com/simoalanne/contract-first-api#readme",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@contract-first-api/api-client": "workspace:^",
		"@contract-first-api/core": "workspace:^"
	},
	"peerDependencies": {
		"@tanstack/react-query": "^5.0.0"
	},
	"devDependencies": {
		"esmock": "^2.7.3"
	}
}
