{
	"name": "@rest-rpc/hono",
	"version": "0.1.0-beta.18",
	"description": "Hono adapter for serving rest-rpc contracts with typed HTTP and WebSocket routes.",
	"keywords": [
		"api-contract",
		"contract-first",
		"edge",
		"hono",
		"http",
		"middleware",
		"rest",
		"rest-rpc",
		"rpc",
		"server",
		"type-safe-api",
		"typescript",
		"websocket"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git",
		"directory": "packages/hono"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "pnpm run build && tsc -p tsconfig.json",
		"test": "pnpm run build && node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*",
		"@rest-rpc/server": "workspace:*"
	},
	"peerDependencies": {
		"hono": "^4.0.0"
	}
}
