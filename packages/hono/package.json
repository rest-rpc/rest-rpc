{
	"name": "@rest-rpc/hono",
	"version": "0.1.0-beta.0",
	"type": "module",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"prepublishOnly": "node ../../scripts/ensure-pnpm-publish.cjs",
		"typecheck": "pnpm run build && tsc -p tsconfig.json",
		"test": "pnpm run build && node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:^",
		"@rest-rpc/server": "workspace:^"
	},
	"peerDependencies": {
		"hono": "^4.0.0"
	}
}
