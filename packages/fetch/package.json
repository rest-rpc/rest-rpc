{
	"name": "@rest-rpc/fetch",
	"version": "0.1.0-beta.14",
	"description": "Fetch runtime adapter for serving rest-rpc contracts with Request and Response handlers.",
	"keywords": [
		"api-contract",
		"contract-first",
		"edge",
		"fetch",
		"http",
		"request",
		"response",
		"rest",
		"rest-rpc",
		"rpc",
		"serverless",
		"type-safe-api",
		"typescript"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git",
		"directory": "packages/fetch"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "node --test src/**/*.test.ts",
		"typecheck": "pnpm run build && tsc -p tsconfig.json && tsd"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*",
		"@rest-rpc/server": "workspace:*"
	},
	"tsd": {
		"directory": "test-d"
	}
}
