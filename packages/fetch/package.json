{
	"name": "@rest-rpc/fetch",
	"version": "0.1.0-beta.23",
	"description": "Fetch runtime adapter for serving rest-rpc contracts with Request and Response handlers.",
	"keywords": [
		"api-contract",
		"contract-first",
		"edge",
		"fetch",
		"http",
		"request",
		"response",
		"rest",
		"rest-rpc",
		"rpc",
		"serverless",
		"type-safe-api",
		"typescript"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git",
		"directory": "packages/fetch"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./deserializeRequestBody": "./src/deserializeRequestBody.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./deserializeRequestBody": {
				"types": "./dist/deserializeRequestBody.d.ts",
				"import": "./dist/deserializeRequestBody.js"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit --declaration false"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*",
		"@rest-rpc/server": "workspace:*"
	}
}
