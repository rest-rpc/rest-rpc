{
	"name": "@rest-rpc/fastify",
	"version": "0.1.0-beta.10",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"prepublishOnly": "node ../../scripts/ensure-pnpm-publish.cjs",
		"typecheck": "pnpm run build && tsc -p tsconfig.json"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*",
		"@rest-rpc/server": "workspace:*"
	},
	"devDependencies": {
		"@fastify/websocket": "^11.0.0",
		"fastify": "^5.0.0"
	},
	"peerDependencies": {
		"@fastify/websocket": "^11.0.0",
		"fastify": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@fastify/websocket": {
			"optional": true
		}
	}
}
