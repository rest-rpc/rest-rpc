{
	"name": "@contract-first-api/api-client",
	"version": "4.3.0",
	"type": "module",
	"description": "Create a typed runtime API client from a shared contract tree.",
	"keywords": [
		"contract-first",
		"api-client",
		"fetch",
		"typescript",
		"zod",
		"http-client"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/contract-first-api.git"
	},
	"homepage": "https://github.com/simoalanne/contract-first-api#readme",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./apiClient": {
			"types": "./dist/apiClient.d.ts",
			"import": "./dist/apiClient.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"prepublishOnly": "node ../../scripts/ensure-pnpm-publish.cjs",
		"typecheck": "tsc -p tsconfig.json",
		"test": "node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@contract-first-api/core": "workspace:^",
		"zod": "^4.3.6"
	}
}
