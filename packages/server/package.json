{
	"name": "@rest-rpc/server",
	"version": "0.1.0-beta.23",
	"description": "Shared rest-rpc server primitives for typed route handlers and adapter implementations.",
	"keywords": [
		"api-contract",
		"contract-first",
		"http",
		"middleware",
		"rest",
		"rest-rpc",
		"route-handlers",
		"rpc",
		"server",
		"type-safe-api",
		"typescript"
	],
	"homepage": "https://github.com/rest-rpc/rest-rpc#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git",
		"directory": "packages/server"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit --declaration false"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*"
	}
}
