{
	"name": "@rest-rpc/server",
	"version": "0.1.0-beta.19",
	"description": "Shared rest-rpc server primitives for typed route handlers and adapter implementations.",
	"keywords": [
		"api-contract",
		"contract-first",
		"http",
		"middleware",
		"rest",
		"rest-rpc",
		"route-handlers",
		"rpc",
		"server",
		"type-safe-api",
		"typescript",
		"websocket"
	],
	"homepage": "https://github.com/rest-rpc/rest-rpc#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rest-rpc/rest-rpc.git",
		"directory": "packages/server"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json && tsd",
		"test": "node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*"
	},
	"devDependencies": {
		"zod": "^4.3.6"
	},
	"tsd": {
		"directory": "test-d"
	}
}
